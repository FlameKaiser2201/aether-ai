{
  "name": "aether-api-edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AETHER API on Cloudflare Workers + D1 (free plan)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute aether-edge --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute aether-edge --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
