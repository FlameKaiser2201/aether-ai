{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aether-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Runtime secrets are set with `wrangler secret put` and are never committed:
  //   AUTH_SECRET, API_URL, AUTH_URL, NEXTAUTH_URL
  "vars": {
    "NODE_ENV": "production"
  }
}
