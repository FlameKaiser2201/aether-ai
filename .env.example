# =============================================================================
# AETHER — environment template
# =============================================================================
# Copy this file to `.env` for Docker Compose. When the API runs from
# `apps/api`, it also reads the repository-root `.env` as a fallback.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every value below is optional for a zero-key local demo. AETHER detects that
# no AI provider is configured and serves clearly labelled demo responses.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Public origin of the Next.js app (used in links and CORS defaults).
APP_URL=http://localhost:3000

# Public origin of this FastAPI service. The Next.js server uses this value to
# reach the API. In Docker Compose the web service overrides it with
# http://api:8000.
API_URL=http://localhost:8000

# Comma-separated host allow-list for TrustedHostMiddleware.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated browser origins allowed to call the API directly. The normal
# browser path is same-origin `/api/proxy`, so this is a defence-in-depth list.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Expose /docs and /openapi.json. Set false in production.
ENABLE_API_DOCS=true

# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-*.
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# 100% free production stack (reference)
# -----------------------------------------------------------------------------
# Frontend: Cloudflare Workers via OpenNext (free plan)
# API:      Render Free, Docker (free plan, no card, sleeps after 15 min idle)
# DB/files: Supabase Free
#
# These are the values for the API service on Render. On Cloudflare, set
# AUTH_SECRET, API_URL, AUTH_URL and NEXTAUTH_URL with `wrangler secret put`;
# never commit them to wrangler.jsonc.
#
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# ENABLE_API_DOCS=false
# AUTO_CREATE_TABLES=false
# COOKIE_SECURE=true
# SEED_DEMO=false
# TRUST_PROXY_HEADERS=true
#
# APP_URL=https://aether-web.<your-subdomain>.workers.dev
# API_URL=https://<service-name>.onrender.com
# CORS_ORIGINS=https://aether-web.<your-subdomain>.workers.dev
# TRUSTED_HOSTS=*
#
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
#
# JWT_ACCESS_SECRET=<48-byte-random>
# JWT_REFRESH_SECRET=<48-byte-random>
# INTERNAL_API_SECRET=<48-byte-random>
#
# REDIS_URL=
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_BUCKET=aether-files
#
# Web tier (Cloudflare Worker):
# AUTH_SECRET=<48-byte-random>
# AUTH_URL=https://aether-web.<your-subdomain>.workers.dev
# NEXTAUTH_URL=https://aether-web.<your-subdomain>.workers.dev
# API_URL=https://<service-name>.onrender.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL for production. The API normalizes postgres:// and postgresql://
# URLs to the asyncpg driver automatically and translates ?sslmode=require into
# the SSL connect argument that asyncpg expects.
#
# Supabase session pooler (IPv4, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether

# Zero-dependency local alternative:
# DATABASE_URL=sqlite+aiosqlite:///./data/aether.db

# Docker Compose uses these to initialize the PostgreSQL container.
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether

# Set false when Alembic owns the schema (recommended in production).
AUTO_CREATE_TABLES=true

# Connection pool (PostgreSQL only).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis (optional)
# -----------------------------------------------------------------------------
# Leave empty to use the in-process rate limiter and cache fallback.
# TLS URLs (rediss://) are supported.
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Authentication — backend JWT issuer
# -----------------------------------------------------------------------------
# All three secrets must be unique, 32+ characters, and must not contain
# "change-me" in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
INTERNAL_API_SECRET=dev-internal-secret-change-me-0123456789

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Seed a demo account for local exploration. Must be false in production.
SEED_DEMO=true
DEMO_EMAIL=demo@aether.local
DEMO_PASSWORD=AetherDemo!2026

# -----------------------------------------------------------------------------
# Authentication — Auth.js / NextAuth on the web tier
# -----------------------------------------------------------------------------
# Must be a 32+ byte random string. The proxy, logout and register routes use
# the same value, so keep it consistent across all web replicas.
AUTH_SECRET=dev-only-aether-secret-change-me-0123456789
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limits
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
CHAT_LIMIT_PER_MINUTE=30
AUTH_LIMIT_PER_MINUTE=10
UPLOAD_LIMIT_PER_HOUR=60
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900

# -----------------------------------------------------------------------------
# AI providers — priority and OpenAI-compatible endpoints
# -----------------------------------------------------------------------------
# Providers are tried in this order. A failing provider is skipped
# automatically at runtime, including mid-conversation. Demo is only used when
# no valid real provider is configured.
#
# Default quality routing follows the product model order:
#   Claude Sonnet via OpenRouter -> GPT-4.1 -> Gemini via OpenRouter ->
#   DeepSeek V4.1 -> Groq
# Set any one key below to switch from the local fallback to live inference.
PROVIDER_PRIORITY=openrouter,openai,deepseek,groq,custom,ollama

# Any OpenAI-compatible endpoint works (OpenAI, Azure-compatible gateways,
# Together, Fireworks, vLLM, LiteLLM, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_BALANCED_MODEL=gpt-4.1
OPENAI_REASONING_MODEL=gpt-4.1
OPENAI_CODING_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# -----------------------------------------------------------------------------
# AI providers — DeepSeek
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# deepseek-flash is DeepSeek V4.1 Flash; deepseek-v4-pro is the stronger
# reasoning/coding model.
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_BALANCED_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_CODING_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-flash

# -----------------------------------------------------------------------------
# AI providers — Groq and OpenRouter (optional)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_BALANCED_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_CODING_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FAST_MODEL=google/gemini-3.8-flash
OPENROUTER_BALANCED_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_REASONING_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_CODING_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-5.5

# -----------------------------------------------------------------------------
# AI providers — custom OpenAI-compatible gateway
# -----------------------------------------------------------------------------
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# -----------------------------------------------------------------------------
# AI providers — Ollama (local / self-hosted)
# -----------------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=llama3.1:8b
OLLAMA_BALANCED_MODEL=llama3.1:8b
OLLAMA_REASONING_MODEL=deepseek-r1:8b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=llava:7b

# -----------------------------------------------------------------------------
# Routing and generation
# -----------------------------------------------------------------------------
# quality: PROVIDER_PRIORITY with the strongest model per task ·
# cost: cheapest capable model · local: prefer Ollama when enabled
ROUTING_STRATEGY=quality
CONTEXT_TOKEN_BUDGET=24000
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0.55
PROVIDER_TIMEOUT_SECONDS=120

# The local fallback is a last resort. If any valid provider key is configured,
# AETHER uses a real model even when DEMO_MODE=true. Invalid or placeholder
# keys are skipped with a startup warning.
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Web research
# -----------------------------------------------------------------------------
# Configure at least one provider for live search. Without one, research mode
# explains the limitation and does not fabricate sources.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SEARXNG_URL=
# Automatically search when a request needs current information (news,
# releases, prices, versions). An explicit web_search=true still forces a
# search and web_search=false opts out.
WEB_SEARCH_AUTO=true
SEARCH_CACHE_SECONDS=1800
SEARCH_MAX_RESULTS=6
SEARCH_FETCH_PAGES=3

# -----------------------------------------------------------------------------
# Voice
# -----------------------------------------------------------------------------
# Browser speech recognition/synthesis is always available. These keys enable
# server-side STT/TTS fallbacks.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# auto: Supabase when configured, otherwise local volume.
# Render and Cloudflare have no persistent disk; use supabase in production.
STORAGE_BACKEND=auto
STORAGE_DIR=./data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=aether-files
MAX_UPLOAD_MB=25
MAX_FILE_CHUNKS=240

# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------
AUTO_MEMORY=true
MEMORY_EMBEDDINGS=true
MAX_MEMORIES_PER_USER=500
MEMORY_RETRIEVAL_LIMIT=8
# Recent turns sent to the model, plus rolling-summary cadence.
HISTORY_TURN_LIMIT=60
SUMMARY_START_AFTER=16
SUMMARY_EVERY_MESSAGES=6

# -----------------------------------------------------------------------------
# Frontend build/runtime
# -----------------------------------------------------------------------------
# Set by the Dockerfile when producing a standalone Next.js server. Cloudflare
# Workers uses OpenNext and does not need this value.
# NEXT_OUTPUT=standalone
